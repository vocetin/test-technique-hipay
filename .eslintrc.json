{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:codeceptjs/recommended"
  ],
  "globals": {
    "inject": "readonly",
    "actor": "readonly",
    "codeceptjs": "readonly",
    "Before": "readonly",
    "After": "readonly",
    "BeforeSuite": "readonly",
    "AfterSuite": "readonly",
    "Given": "readonly",
    "When": "readonly",
    "Then": "readonly",
    "locate": "readonly"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": ["node_modules/", "allure-results/", "allure-report/", "output/"]
}
